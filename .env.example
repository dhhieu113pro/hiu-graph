# Local llama.cpp runtime (required for indexing/re-indexing; not required for MCP retrieval once an index exists)
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# Absolute path to a local GGUF model served by llama-server.
LLAMA_CPP_MODEL=C:\\path\\to\\gemma-3-4b-it-Q4_K_M.gguf
LLAMA_CPP_MODEL_NAME=local-gemma
# Maximum first-run wait for llama.cpp when the GraphRAG index is missing.
HIU_GRAPH_LLM_WAIT_TIMEOUT_SECONDS=300
# Embeddings run locally with FastEmbed for both indexing and MCP query retrieval.
FASTEMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=.cache/fastembed

# Monitoring (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_TRACING_ENDPOINT=http://localhost:4317
# Empty (default) pins the stable v1.36.0 GenAI semconv baseline; set to
# "gen_ai_latest_experimental" to opt into the conventions above that baseline.
OTEL_SEMCONV_STABILITY_OPT_IN=

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8011
MCP_SERVER_NAME=graphrag-mcp
MCP_SERVER_VERSION=1.0.0
GRAPHRAG_ROOT=.
MCP_CORS_ORIGINS=http://127.0.0.1:8011

# Logging rotation (optional)
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
